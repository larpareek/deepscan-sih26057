# SEASCAN (SIH26057) environment variables.
# Copy to .env (never commit real values). Frontend and backend read them differently:

# ---------------------------------------------------------------------------
# Frontend (Vite). Vite only loads env files from its own root, so put these
# in ui/.env (local) or in the Vercel project settings (production).
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend. Leave unset in local dev to use the
# built-in /api proxy (ui/vite.config.js -> http://localhost:8000).
VITE_API_BASE=https://deepscan-api-production.up.railway.app

# ---------------------------------------------------------------------------
# Backend (FastAPI, src/api.py). Read from the process environment, so export
# them in your shell or set them in the Render/Railway dashboard.
# ---------------------------------------------------------------------------
# Detector weights (.pt or exported .onnx). Defaults to the trained SEASCAN model.
SSS_WEIGHTS=models/seascan-yolov8n.pt
# Inference device: "cpu", "0" for the first CUDA GPU, or empty for auto.
SSS_DEVICE=
# Maximum accepted upload size for sonar images, in MB.
SSS_MAX_UPLOAD_MB=50
# Comma-separated origins allowed to call the API (CORS). Use your Vercel URL in
# production; "*" (the default) allows any origin.
SSS_CORS_ORIGINS=https://your-app.vercel.app
# Render/Railway: Python version for the build (also pinned in .python-version).
PYTHON_VERSION=3.12

# ---------------------------------------------------------------------------
# SEASCAN AI (POST /chat). Server-side only: never put this key in ui/.env or
# any VITE_ variable. Locally it can live in src/.env (git-ignored).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional: models tried in order when one is overloaded (HTTP 503/429).
GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash
# Optional: questions per client per minute.
SSS_CHAT_PER_MIN=12
